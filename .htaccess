# Hostinger (LiteSpeed/Apache)
ErrorDocument 404 /404.html
DirectoryIndex index.html

# Never serve secrets or build tools
<FilesMatch "^(README\.md|\.gitignore)$">
  Require all denied
</FilesMatch>
RedirectMatch 404 ^/_src/
RedirectMatch 404 ^/\.git

# One address for Google and Facebook: https://eriesistibleclowns.org
# erieclowns.com, www and plain http all 301 here. Keep in sync with SITE["url"] in _src/build.py.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} !^eriesistibleclowns\.org$ [NC,OR]
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://eriesistibleclowns.org%{REQUEST_URI} [L,R=301]
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType application/xml "access plus 0 seconds"
  ExpiresByType application/manifest+json "access plus 7 days"
</IfModule>

AddType application/manifest+json .webmanifest
